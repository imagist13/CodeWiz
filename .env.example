# Hermes Environment Variables

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=1478

# LLM Provider
HERMES_PROVIDER=openai
HERMES_MODEL=gpt-4o
HERMES_API_KEY=your-api-key-here

# Optional: DeepSeek
DEEPSEEK_API_KEY=

# Optional: Anthropic
ANTHROPIC_API_KEY=

# Security
HERMES_SECRET_KEY=change-me-in-production

# Paths
HERMES_DATA_DIR=
