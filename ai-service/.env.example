# CodeWiz AI Service Environment Configuration
# Copy to .env and configure for production

# Application
APP_NAME=CodeWiz AI Service
DEBUG=false

# Database
DATABASE_URL=host=localhost user=postgres password=postgres dbname=codewiz port=5432 sslmode=disable

# JWT Secret - MUST match Go backend
JWT_SECRET=codewiz-dev-secret-change-in-prod

# Go Backend URL (internal service name in Docker)
BACKEND_URL=http://backend:8080

# LLM Configuration
# Provider: silicon_flow | openai | deepseek | zhipu | openai_compatible
LLM_PROVIDER=silicon_flow
LLM_API_KEY=your-api-key-here
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Silicon Flow (legacy, fallback when LLM_API_KEY is empty)
SILICON_FLOW_API_URL=https://api.siliconflow.cn/v1
SILICON_FLOW_API_KEY=your-api-key-here

# File Storage
UPLOAD_DIR=./uploads